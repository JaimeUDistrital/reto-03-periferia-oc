{
  "name": "reto-03-periferia-oc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional que valida solicitudes de compra y crea órdenes en un SAP simulado, con confirmación humana.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:server": "node --watch --import tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "demo": "node --import tsx demo.ts",
    "modulo": "node --import tsx scripts/modulo.ts"
  },
  "dependencies": {
    "@google/genai": "3.1.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
