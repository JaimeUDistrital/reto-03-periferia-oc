# Copia este archivo a .env y pega tu clave. .env nunca va a git.
GEMINI_API_KEY=
# Modelo Gemini Flash estable (verificado 2026-11-10 en aistudio.google.com/docs/models)
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
# Tope de iteraciones herramienta → modelo por turno (PRD CA1)
MAX_ITERACIONES=25
# Tope de tokens por sesión: nadie puede gastar la clave sin límite (PRD §8 Costo)
MAX_TOKENS_SESION=200000
